// Donnée disponible : vert ; absence explicitement signalée : rose, hors périmètre : gris
// Dépendances : Population Data Status
UI Population Status Color =
VAR __MetricValue = [Population Data Status]
RETURN
    SWITCH (
        __MetricValue,
        "Disponible",
        "#34D399",
        "Absente",
        "#FB7185",
        "#94A3B8"
    )

