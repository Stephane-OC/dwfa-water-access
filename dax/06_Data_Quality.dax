// Contrôle de ventilation : cohérent vert, écart rose, ventilation incomplète ambre
// Dépendances : Population Consistency Status
UI Population Consistency Color =
VAR __MetricValue = [Population Consistency Status]
RETURN
    SWITCH (
        __MetricValue,
        "Écart ≤ 1 %",
        "#34D399",
        "Écart > 1 %",
        "#FB7185",
        "Ventilation incomplète",
        "#FBBF24",
        "Total absent",
        "#FB7185",
        "#94A3B8"
    )