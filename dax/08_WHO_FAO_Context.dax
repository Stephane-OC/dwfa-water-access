// ============================================================================
// MESURES : Contexte OMS / FAO
// TABLE   : _Measures
// ÉTAPE   : 5 — Contexte OMS / FAO
// OBJECTIF: Ajouter les calculs nécessaires à cette étape du rapport
// CRÉATION: Créer chaque mesure séparément, de haut en bas
// PRÉREQUIS: Fichiers 00 à 07 déjà appliqués ; modèle Power Query chargé 
// ============================================================================

// Moyenne pondérée par la population du brief, uniquement sur les pays renseignés, nouvelle édition OMS/UNICEF, pas un agrégat officiel OMS
// Dépendances : Colonnes et paramètres du modèle Power Query
Sanitation Basic Access Total =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
VAR Observed =
    FILTER (
        Eligible,
        NOT ISBLANK (Fact_CountryYear[SanitationBasicTotal]) && Fact_CountryYear[PopulationTotal] > 0
    )
RETURN
    DIVIDE (
        SUMX (
            Observed,
            Fact_CountryYear[PopulationTotal] * Fact_CountryYear[SanitationBasicTotal]
        ),
        SUMX (
            Observed,
            Fact_CountryYear[PopulationTotal]
        )
    )

// Pays avec taux renseigné et population positive, selon le filtre de stabilité
// Dépendances : Colonnes et paramètres du modèle Power Query
Sanitation Countries Covered =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
VAR Observed =
    FILTER (
        Eligible,
        NOT ISBLANK (Fact_CountryYear[SanitationBasicTotal]) && Fact_CountryYear[PopulationTotal] > 0
    )
RETURN
    COALESCE (
        COUNTROWS (Observed),
        0
    )

// Couverture du taux pondéré ; une absence n’est pas un accès nul
// Dépendances : Population Total
Sanitation Population Coverage =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
VAR Observed =
    FILTER (
        Eligible,
        NOT ISBLANK (Fact_CountryYear[SanitationBasicTotal]) && Fact_CountryYear[PopulationTotal] > 0
    )
RETURN
    IF (
        [Population Total] > 0,
        DIVIDE (
            COALESCE (
                SUMX (
                    Observed,
                    Fact_CountryYear[PopulationTotal]
                ),
                0
            ),
            [Population Total]
        )
    )

