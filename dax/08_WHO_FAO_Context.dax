// Superficie terrestre FAO en km², uniquement pour les pays avec population positive du même millésime
// Dépendances : Colonnes et paramètres du modèle Power Query
Land Area Covered Km2 =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
VAR Observed =
    FILTER (
        Eligible,
        Fact_CountryYear[LandAreaKm2] > 0 && Fact_CountryYear[PopulationTotal] > 0
    )
RETURN
    SUMX (
        Observed,
        Fact_CountryYear[LandAreaKm2]
    )

// Personnes par km² terrestre ; au niveau agrégé, ratio des sommes sur une cohorte commune, pas moyenne des densités. Rapprochement territorial à interpréter avec prudence
// Dépendances : Colonnes et paramètres du modèle Power Query
Population Density Covered =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
VAR Observed =
    FILTER (
        Eligible,
        Fact_CountryYear[LandAreaKm2] > 0 && Fact_CountryYear[PopulationTotal] > 0
    )
RETURN
    DIVIDE (
        SUMX (
            Observed,
            Fact_CountryYear[PopulationTotal]
        ),
        SUMX (
            Observed,
            Fact_CountryYear[LandAreaKm2]
        )
    )

