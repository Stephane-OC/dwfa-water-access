// ============================================================================
// MESURES : Santé, stabilité et besoins d’intervention
// TABLE   : _Measures
// ÉTAPE   : 1 — Monde · Synthèse et Monde · Carte
// OBJECTIF: Ajouter les indicateurs santé et le classement sanitaire Top 5 / Top 10
// CRÉATION: Créer chaque mesure séparément, de haut en bas
// PRÉREQUIS: Fichiers 00 à 02 déjà appliqués ; modèle Power Query chargé
// ============================================================================

// Moyenne simple des pays renseignés ; un pays = une voix, indicateur non démographique
// Dépendances : Colonnes et paramètres du modèle Power Query
Political Stability Mean =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
RETURN
    AVERAGEX (
        Eligible,
        Fact_CountryYear[PoliticalStability]
    )

// Taux WASH pour 100 000 ; pondération par population FAO ; pas de report hors 2016
// Dépendances : Colonnes et paramètres du modèle Power Query
Mortality Rate Weighted =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
VAR Available =
    FILTER (
        Eligible,
        NOT ISBLANK (Fact_CountryYear[MortalityRate]) && Fact_CountryYear[PopulationTotal] > 0
    )
RETURN
    DIVIDE (
        SUMX (
            Available,
            Fact_CountryYear[MortalityRate] * Fact_CountryYear[PopulationTotal]
        ),
        SUMX (
            Available,
            Fact_CountryYear[PopulationTotal]
        )
    )

// Somme des estimations OMS Total ; pas de recalcul depuis la population FAO
// Dépendances : Colonnes et paramètres du modèle Power Query
WASH Deaths =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
RETURN
    SUMX (
        Eligible,
        Fact_CountryYear[WASHDeaths]
    )

// Proxy exploratoire sur 100, pondération 50/50 et plafond mortalité 100 choisis pour le projet ; aucune causalité politique
// Dépendances : Basic Access Total, Mortality Rate Weighted
Access Health Profile Score =
VAR Access = [Basic Access Total]
VAR Mortality = [Mortality Rate Weighted]
RETURN
    IF (
        HASONEVALUE (Dim_Country[Country]) && NOT ISBLANK (Access) && NOT ISBLANK (Mortality),
        50 * Access + 50 * ( 1 - MIN (DIVIDE (Mortality, 100), 1))
    )

// Indicateur complémentaire du périmètre sélectionné
// Dépendances : People Without Basic Service
Creation Need People =
[People Without Basic Service]

// Taux de mortalité WASH pour 100 000 habitants ; un pays et 2016 uniquement, selon le filtre de stabilité
// Dépendances : Analysis Year, Mortality Rate Weighted
Health Priority Rate =
IF (
    [Analysis Year] = 2016 && HASONEVALUE (Dim_Country[Country]),
    [Mortality Rate Weighted]
)

// Rang dans le périmètre sélectionné ; taux décroissant à six décimales, puis décès décroissants et pays alphabétique
// Dépendances : Health Priority Rate, WASH Deaths
Health Priority Rank =
VAR CountryName =
    SELECTEDVALUE (Dim_Country[Country])
VAR CurrentRate = [Health Priority Rate]
VAR RateKey =
    ROUND (
        CurrentRate,
        6
    )
VAR DeathsKey =
    COALESCE (
        [WASH Deaths],
        -1
    )
VAR Candidates =
    ADDCOLUMNS (
        ALLSELECTED (Dim_Country),
        "__Rate",
        ROUND (
            CALCULATE ([Health Priority Rate]),
            6
        ),
        "__Deaths",
        COALESCE (
            CALCULATE ([WASH Deaths]),
            -1
        )
    )
VAR Eligible =
    FILTER (
        Candidates,
        NOT ISBLANK ([__Rate]) && [__Rate] > 0
    )
VAR Ahead =
    FILTER (
        Eligible,
        [__Rate] > RateKey ||
        ( [__Rate] =
            RateKey && [__Deaths] > DeathsKey) ||
        ( [__Rate] =
            RateKey && [__Deaths] =
            DeathsKey && Dim_Country[Country] < CountryName)
    )
RETURN
    IF (
        NOT ISBLANK (CountryName) && NOT ISBLANK (CurrentRate) && CurrentRate > 0,
        1 + COUNTROWS (Ahead)
    )

// Filtre de la carte et du tableau ; conserver la valeur 1 pour afficher les pays du Top choisi
// Dépendances : Health Priority Rank, Priority Top N
Health Priority In Top N =
VAR CountryRank = [Health Priority Rank]
RETURN
    IF (
        NOT ISBLANK (CountryRank),
        IF (CountryRank <= [Priority Top N], 1, 0)
    )

// Taille des bulles = taux de mortalité des pays du Top ; les décès absolus restent un indicateur distinct
// Dépendances : Health Priority In Top N, Health Priority Rate
Health Priority Map Size =
IF ([Health Priority In Top N] = 1, [Health Priority Rate])

// Pays à mortalité positive et population positive retenus avant la limitation au Top
// Dépendances : Health Priority Rate, Analysis Year
Health Priority Candidate Count =
VAR Candidates =
    ADDCOLUMNS (
        ALLSELECTED (Dim_Country),
        "__Rate",
        CALCULATE ([Health Priority Rate])
    )
RETURN
    IF (
        [Analysis Year] = 2016,
        COALESCE (
            COUNTROWS (
                FILTER (
                    Candidates,
                    NOT ISBLANK ([__Rate]) && [__Rate] > 0
                )
            ),
            0
        )
    )

// Pays à mortalité et population positives écartés sous le seuil actif ; stabilité absente comptée séparément
// Dépendances : Analysis Year, Stability Minimum, Stability Filter Enabled ; Fact_CountryYear et Dim_Country
Health Priority Excluded Stability Count =
VAR Y = [Analysis Year]
VAR Cutoff = [Stability Minimum]
VAR ApplyFilter = [Stability Filter Enabled] = 1
VAR RowsInScope =
    CALCULATETABLE (
        Fact_CountryYear,
        ALLSELECTED (Dim_Country)
    )
RETURN
    IF (
Y = 2016,
IF (
    ApplyFilter,
    COALESCE (
        COUNTROWS (
            FILTER (
                RowsInScope,
                Fact_CountryYear[Year] =
                Y && Fact_CountryYear[PopulationTotal] > 0 &&
                NOT ISBLANK (Fact_CountryYear[MortalityRate]) && Fact_CountryYear[MortalityRate] > 0 &&
                NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] < Cutoff
            )
        ),
        0
    ),
    0
)
)

// Pays à mortalité et population positives sans indice de stabilité ; exclus uniquement si le seuil est activé
// Dépendances : Analysis Year, Stability Minimum, Stability Filter Enabled ; Fact_CountryYear et Dim_Country
Health Priority Unknown Stability Count =
VAR Y = [Analysis Year]
VAR Cutoff = [Stability Minimum]
VAR ApplyFilter = [Stability Filter Enabled] = 1
VAR RowsInScope =
    CALCULATETABLE (
        Fact_CountryYear,
        ALLSELECTED (Dim_Country)
    )
RETURN
    IF (
Y = 2016,
COALESCE (
    COUNTROWS (
        FILTER (
            RowsInScope,
            Fact_CountryYear[Year] =
            Y && Fact_CountryYear[PopulationTotal] > 0 &&
            NOT ISBLANK (Fact_CountryYear[MortalityRate]) && Fact_CountryYear[MortalityRate] > 0 &&
            ISBLANK (Fact_CountryYear[PoliticalStability])
        )
    ),
    0
)
)

// Pays admissibles selon le mode de stabilité mais sans mortalité ; une absence ne vaut jamais zéro
// Dépendances : Analysis Year, Stability Minimum, Stability Filter Enabled ; Fact_CountryYear et Dim_Country
Health Priority Missing Mortality Count =
VAR Y = [Analysis Year]
VAR Cutoff = [Stability Minimum]
VAR ApplyFilter = [Stability Filter Enabled] = 1
VAR RowsInScope =
    CALCULATETABLE (
        Fact_CountryYear,
        ALLSELECTED (Dim_Country)
    )
RETURN
    IF (
Y = 2016,
COALESCE (
    COUNTROWS (
        FILTER (
            RowsInScope,
            Fact_CountryYear[Year] =
            Y && ISBLANK (Fact_CountryYear[MortalityRate]) &&
            ( NOT (ApplyFilter) ||
                ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                    Cutoff))
        )
    ),
    0
)
)