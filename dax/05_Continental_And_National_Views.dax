// Estimation limitée aux pays avec donnée ; absence de taux jamais assimilée à zéro
// Dépendances : Colonnes et paramètres du modèle Power Query
People Without Safe Service =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
VAR Available =
    FILTER (
        Eligible,
        NOT ISBLANK (Fact_CountryYear[SafeTotal]) && Fact_CountryYear[PopulationTotal] > 0
    )
RETURN
    SUMX (
        Available,
        ( 1 - Fact_CountryYear[SafeTotal]) * Fact_CountryYear[PopulationTotal]
    )

// Au moins basique inclut sûr ; segment exclusif = basique moins sûr
// Dépendances : Basic Access Comparable, Safe Access Comparable
Basic Only Share =
IF (
    NOT ISBLANK ([Basic Access Comparable]) && NOT ISBLANK ([Safe Access Comparable]),
    [Basic Access Comparable] - [Safe Access Comparable]
)

// Indicateur complémentaire du périmètre sélectionné
// Dépendances : Basic Access Comparable
Below Basic Share =
IF (NOT ISBLANK ([Basic Access Comparable]), 1 - [Basic Access Comparable])

// Écart en points de pourcentage, pas variation relative
// Dépendances : Basic Only Share
Modernization Gap pp =
[Basic Only Share] * 100

// Indicateur à lire au niveau national ; les cohortes agrégées peuvent différer
// Dépendances : Basic Access Rural, Basic Access Urban
Urban Rural Access Gap pp =
IF (
    NOT ISBLANK ([Basic Access Urban]) && NOT ISBLANK ([Basic Access Rural]),
    ( [Basic Access Urban] - [Basic Access Rural]) * 100
)

// Libellé du périmètre sélectionné
// Dépendances : Colonnes et paramètres du modèle Power Query
Selected Country Label =
SELECTEDVALUE (
    Dim_Country[Country],
    "Choisir un pays"
)

// Libellé du périmètre sélectionné
// Dépendances : Colonnes et paramètres du modèle Power Query
Selected Continent Label =
SELECTEDVALUE (
    Dim_Country[Continent],
    "Choisir un continent"
)

// Indicateur complémentaire du périmètre sélectionné
// Dépendances : Colonnes et paramètres du modèle Power Query
National Selection Valid =
IF (HASONEVALUE (Dim_Country[Country]), 1, 0)

// Indicateur complémentaire du périmètre sélectionné
// Dépendances : Colonnes et paramètres du modèle Power Query
Continental Selection Valid =
IF (HASONEVALUE (Dim_Country[Continent]), 1, 0)