// ============================================================================
// MESURES : Vue continentale et Vue nationale
// TABLE   : _Measures
// ÉTAPE   : 2 — Vue continentale et Vue nationale
// OBJECTIF: Ajouter les calculs nécessaires à cette étape du rapport
// CRÉATION: Créer chaque mesure séparément, de haut en bas
// PRÉREQUIS: Fichiers 00 à 04 déjà appliqués, modèle Power Query chargé 
// ============================================================================

// Moyenne pondérée ; seuls les pays avec taux et population du milieu participent
// Dépendances : Colonnes et paramètres du modèle Power Query
Basic Access Urban =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
VAR Available =
    FILTER (
        Eligible,
        NOT ISBLANK (Fact_CountryYear[BasicUrban]) && Fact_CountryYear[PopulationUrban] > 0
    )
RETURN
    DIVIDE (
        SUMX (
            Available,
            Fact_CountryYear[BasicUrban] * Fact_CountryYear[PopulationUrban]
        ),
        SUMX (
            Available,
            Fact_CountryYear[PopulationUrban]
        )
    )

