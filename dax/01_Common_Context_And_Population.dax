// ============================================================================
// MESURES : Contexte commun, filtres et population
// TABLE   : _Measures
// ÉTAPE   : 1 — Monde · Synthèse et Monde · Carte
// OBJECTIF: Ajouter les calculs nécessaires à cette étape du rapport
// CRÉATION: Créer chaque mesure séparément, de haut en bas
// PRÉREQUIS: Les deux fichiers 00 déjà appliqués ; modèle Power Query chargé
// ============================================================================

// Une seule année requise pour les KPI, sur une courbe, chaque point définit son année
// Dépendances : Colonnes et paramètres du modèle Power Query
Analysis Year =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
RETURN
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )

// Indicateur complémentaire du périmètre sélectionné.
// Dépendances : Colonnes et paramètres du modèle Power Query.
Stability Minimum =
CONVERT (
    SELECTEDVALUE (
        Param_Stability[Minimum],
        -2.5
    ),
    DOUBLE
)

// Indicateur complémentaire du périmètre sélectionné
// Dépendances : Colonnes et paramètres du modèle Power Query
Stability Filter Enabled =
CONVERT (
    IF (
        SELECTEDVALUE (
            Param_StabilityMode[Mode],
            "Tous les pays"
        ) = "Appliquer le seuil",
        1,
        0
    ),
    INTEGER
)

// Population source en personnes ; année unique et seuil éventuel
// Dépendances : Colonnes et paramètres du modèle Power Query 
Population Total =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
RETURN
    SUMX (
        Eligible,
        Fact_CountryYear[PopulationTotal]
    )

// Population source en personnes ; année unique et seuil éventuel
// Dépendances : Colonnes et paramètres du modèle Power Query
Population Urban =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
RETURN
    SUMX (
        Eligible,
        Fact_CountryYear[PopulationUrban]
    )

// Population source en personnes ; année unique et seuil éventuel
// Dépendances : Colonnes et paramètres du modèle Power Query
Population Rural =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
RETURN
    SUMX (
        Eligible,
        Fact_CountryYear[PopulationRural]
    )

// Part urbaine = urbain / (urbain + rural), séries de même ventilation ; cohérence avec le total source non garantie
// Dépendances : Colonnes et paramètres du modèle Power Query
Urban Population Share =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
VAR Available =
    FILTER (
        Eligible,
        NOT ISBLANK (Fact_CountryYear[PopulationUrban]) && NOT ISBLANK (Fact_CountryYear[PopulationRural])
    )
RETURN
    DIVIDE (
        SUMX (
            Available,
            Fact_CountryYear[PopulationUrban]
        ),
        SUMX (
            Available,
            Fact_CountryYear[PopulationUrban] + Fact_CountryYear[PopulationRural]
        )
    )

// Indicateur complémentaire du périmètre sélectionné
// Dépendances : Colonnes et paramètres du modèle Power Query
Countries Included =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
RETURN
    COALESCE (
        COUNTROWS (Eligible),
        0
    )

// Filtre explicite des tableaux : un pays, une année et respect du mode de stabilité
// Dépendances : Analysis Year, Countries Included
Eligible Country =
IF (
    HASONEVALUE (Dim_Country[Country]) && NOT ISBLANK ([Analysis Year]) && [Countries Included] > 0,
    1,
    0
)

// Nombre de pays du classement ; sélection 5 ou 10, valeur par défaut 10
// Dépendances : Param_PriorityTopN[TopN]
Priority Top N =
VAR Choice =
    SELECTEDVALUE (
        Param_PriorityTopN[TopN],
        10
    )
RETURN
    IF (Choice IN {
            5, 10}, Choice, 10)