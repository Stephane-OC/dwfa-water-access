// Indicateur complémentaire du périmètre sélectionné
// Dépendances : Colonnes et paramètres du modèle Power Query
Basic Countries Covered =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
RETURN
    COALESCE (
        COUNTROWS (
            FILTER (
                Eligible,
                NOT ISBLANK (Fact_CountryYear[BasicTotal]) && Fact_CountryYear[PopulationTotal] > 0
            )
        ),
        0
    )

// Indicateur complémentaire du périmètre sélectionné
// Dépendances : Population Total
Basic Population Coverage =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
VAR Available =
    FILTER (
        Eligible,
        NOT ISBLANK (Fact_CountryYear[BasicTotal]) && Fact_CountryYear[PopulationTotal] > 0
    )
RETURN
    IF (
        [Population Total] > 0,
        COALESCE (
            DIVIDE (
                SUMX (
                    Available,
                    Fact_CountryYear[PopulationTotal]
                ),
                [Population Total]
            ),
            0
        )
    )

// Estimation limitée aux pays avec donnée ; absence de taux jamais assimilée à zéro
// Dépendances : Colonnes et paramètres du modèle Power Query
People Without Basic Service =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
VAR Available =
    FILTER (
        Eligible,
        NOT ISBLANK (Fact_CountryYear[BasicTotal]) && Fact_CountryYear[PopulationTotal] > 0
    )
RETURN
    SUMX (
        Available,
        ( 1 - Fact_CountryYear[BasicTotal]) * Fact_CountryYear[PopulationTotal]
    )

