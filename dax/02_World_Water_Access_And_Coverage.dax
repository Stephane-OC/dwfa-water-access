// ============================================================================
// MESURES : Accès à l’eau et couverture mondiale
// TABLE   : _Measures
// ÉTAPE   : 1 — Monde · Synthèse et Monde · Carte
// OBJECTIF: Ajouter les calculs nécessaires à cette étape du rapport
// CRÉATION: Créer chaque mesure séparément, de haut en bas
// PRÉREQUIS: Fichiers 00 à 01 déjà appliqués ; modèle Power Query chargé 
// ============================================================================

// Moyenne pondérée ; seuls les pays avec taux et population du milieu participent
// Dépendances : Colonnes et paramètres du modèle Power Query
Basic Access Total =
VAR SelectedYear =
    SELECTEDVALUE (Dim_Year[Year])
VAR Y =
    IF (
        NOT ISBLANK (SelectedYear),
        CONVERT (
            SelectedYear,
            INTEGER
        )
    )
VAR Cutoff =
    CONVERT (
        SELECTEDVALUE (
            Param_Stability[Minimum],
            -2.5
        ),
        DOUBLE
    )
VAR ApplyFilter =
    SELECTEDVALUE (
        Param_StabilityMode[Mode],
        "Tous les pays"
    ) = "Appliquer le seuil"
VAR Eligible =
    FILTER (
        Fact_CountryYear,
        NOT ISBLANK (Y) && Fact_CountryYear[Year] =
        Y &&
        ( NOT (ApplyFilter) || ( NOT ISBLANK (Fact_CountryYear[PoliticalStability]) && Fact_CountryYear[PoliticalStability] >=
                Cutoff))
    )
VAR Available =
    FILTER (
        Eligible,
        NOT ISBLANK (Fact_CountryYear[BasicTotal]) && Fact_CountryYear[PopulationTotal] > 0
    )
RETURN
    DIVIDE (
        SUMX (
            Available,
            Fact_CountryYear[BasicTotal] * Fact_CountryYear[PopulationTotal]
        ),
        SUMX (
            Available,
            Fact_CountryYear[PopulationTotal]
        )
    )

