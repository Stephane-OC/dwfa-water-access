expression stg_ExternalContext =
		let
		    Mode = pExternalSourceMode,
		    Output =
		        if Mode = "CSV fourni" then
		            let
		                Source = fxReadCsv("ExternalContextCountryYear.csv"),
		                Typed = Table.TransformColumnTypes(
		                    Source,
		                    {
		                        {"Country", type text},
		                        {"ISO3", type text},
		                        {"Year", Int64.Type},
		                        {"SanitationBasicPercent", type number},
		                        {"HygieneBasicPercent", type number},
		                        {"LandArea1000Ha", type number},
		                        {"FAOLandFlag", type text}
		                    },
		                    "en-US"
		                ),
		
		                Converted = Table.TransformColumns(
		                    Typed,
		                    {
		                        {"SanitationBasicPercent", each fxPercent(_), type number},
		                        {"HygieneBasicPercent", each fxPercent(_), type number},
		                        {"LandArea1000Ha", each if _ = null then null else _ * 10, type number}
		                    }
		                ),
		                Named = Table.RenameColumns(
		                    Converted,
		                    {
		                        {"SanitationBasicPercent", "SanitationBasicTotal"},
		                        {"HygieneBasicPercent", "HygieneBasicTotal"},
		                        {"LandArea1000Ha", "LandAreaKm2"}
		                    }
		                ),
		                Selected = Table.SelectColumns(
		                    Named, {"Country", "Year", "SanitationBasicTotal", "HygieneBasicTotal", "LandAreaKm2"}
		                ),
		                Unique = fxAssertUnique(Selected, {"Country", "Year"}, "stg_ExternalContext")
		            in
		                Unique
		        else if Mode = "Fichiers bruts" or Mode = "En ligne" then
		            stg_ExternalContextFromSources
		        else
		            error Error.Record("InvalidExternalMode", "Valeurs admises : CSV fourni, Fichiers bruts, En ligne", Mode)
		in
		    Output
	lineageTag: 8b6e7628-18c6-40e6-b57b-573ce6e492e9

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression fxReadZipCsv =
		(archive as binary, fileName as text) as table =>
		    let
		        Zip = Binary.Buffer(archive),
		        Size = Binary.Length(Zip),
		        UInt = (offset as number, length as number) as number =>
		            let
		                Bytes = Binary.ToList(Binary.Range(Zip, offset, length))
		            in
		                List.Sum(List.Transform({0..length - 1}, each Bytes{_} * Number.Power(256, _))),
		        Find = (offset as number) as binary =>
		            if offset + 4 > Size then
		                error Error.Record("ZipFileNotFound", "CSV absent de l'archive", fileName)
		            else if UInt(offset, 4) <> 67324752 then
		                error Error.Record("ZipFileNotFound", "CSV absent ou format ZIP non pris en charge", fileName)
		            else
		                let
		                    Flags = UInt(offset + 6, 2),
		                    Method = UInt(offset + 8, 2),
		                    CompressedSize = UInt(offset + 18, 4),
		                    UncompressedSize = UInt(offset + 22, 4),
		                    NameLength = UInt(offset + 26, 2),
		                    ExtraLength = UInt(offset + 28, 2),
		                    EntryName = Text.FromBinary(Binary.Range(Zip, offset + 30, NameLength), TextEncoding.Utf8),
		                    PayloadOffset = offset + 30 + NameLength + ExtraLength,
		                    NextOffset = PayloadOffset + CompressedSize,
		                    Unsupported =
		                        Number.Mod(Flags, 2) = 1
		                        or Number.Mod(Number.IntegerDivide(Flags, 8), 2) = 1
		                        or CompressedSize = 4294967295
		                        or UncompressedSize = 4294967295,
		                    Result =
		                        if Unsupported then
		                            error
		                                Error.Record(
		                                    "UnsupportedZip",
		                                    "ZIP chiffré, ZIP64 ou descripteur de données non pris en charge",
		                                    EntryName
		                                )
		                        else if NextOffset > Size then
		                            error Error.Record("TruncatedZip", "Archive ZIP incomplète", EntryName)
		                        else if EntryName <> fileName then
		                            @Find(NextOffset)
		                        else
		                            let
		                                Payload = Binary.Range(Zip, PayloadOffset, CompressedSize),
		                                Unpacked =
		                                    if Method = 0 then
		                                        Payload
		                                    else if Method = 8 then
		                                        Binary.Decompress(Payload, Compression.Deflate)
		                                    else
		                                        error
		                                            Error.Record(
		                                                "UnsupportedZipCompression",
		                                                "Méthode de compression non prise en charge",
		                                                Method
		                                            )
		                            in
		                                if Binary.Length(Unpacked) <> UncompressedSize then
		                                    error
		                                        Error.Record("InvalidZipLength", "Taille décompressée incorrecte", EntryName)
		                                else
		                                    Unpacked
		                in
		                    Result,
		        CsvBinary = Find(0),
		        Csv = Csv.Document(CsvBinary, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		        Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars = true]),
		        MissingAsNull = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers))
		    in
		        MissingAsNull
	lineageTag: ed4f9d7e-14ac-4450-8aa4-54e15c9b94f4

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression src_OMSContext =
		let
		    Folder = Text.TrimEnd(pExternalFolder, {"\", "/"}),
		    Geo = fxAssertUnique(Table.SelectColumns(Dim_Country, {"Country", "ISO3"}), {"ISO3"}, "OMS ISO3"),
		    ReadPage = (path as text, query as record) as record =>
		        Json.Document(
		            Web.Contents(
		                "https://ghoapi.azureedge.net", [RelativePath = path, Query = query, Timeout = #duration(0, 0, 3, 0)]
		            )
		        ),
		    ReadAll = (indicator as text) as list =>
		        let
		            Filter = "SpatialDimType eq 'COUNTRY' and Dim1 eq 'RESIDENCEAREATYPE_TOTL' and TimeDim ge 2000 and TimeDim le 2018",
		            First = ReadPage("api/" & indicator, [#"$filter" = Filter]),
		            Pages = List.Generate(
		                () => [Doc = First, More = true],
		                each [More],
		                each
		                    let
		                        Next = Record.FieldOrDefault([Doc], "@odata.nextLink", null)
		                    in
		                        if Next = null then
		                            [Doc = null, More = false]
		                        else
		                            let
		                                Parts = Uri.Parts(Next)
		                            in
		                                if Text.Lower(Parts[Host]) <> "ghoapi.azureedge.net" then
		                                    error
		                                        Error.Record(
		                                            "UnexpectedWHOHost", "Hôte de pagination inattendu", Parts[Host]
		                                        )
		                                else
		                                    [Doc = ReadPage(Text.TrimStart(Parts[Path], "/"), Parts[Query]), More = true],
		                each[Doc][value]
		            ),
		            Combined = List.Combine(Pages)
		        in
		            Combined,
		    GetIndicator = (indicator as text, localFile as text, metric as text) as table =>
		        let
		            Records =
		                if pExternalSourceMode = "En ligne" then
		                    ReadAll(indicator)
		                else
		                    let
		                        Doc = Json.Document(File.Contents(fxLatestExternalFile({indicator}, {".json"})))
		                    in
		                        if Record.FieldOrDefault(Doc, "@odata.nextLink", null) <> null then
		                            error
		                                Error.Record(
		                                    "IncompleteWHOExtract",
		                                    "Extraction JSON incomplète ; utiliser le mode En ligne",
		                                    localFile
		                                )
		                        else
		                            Doc[value],
		            Raw = Table.FromRecords(Records),
		            Selected = Table.SelectRows(
		                Raw,
		                each
		                    [IndicatorCode] = indicator
		                    and [SpatialDimType] = "COUNTRY"
		                    and [TimeDimType] = "YEAR"
		                    and [Dim1] = "RESIDENCEAREATYPE_TOTL"
		                    and [Dim2] = null
		                    and [Dim3] = null
		                    and [TimeDim] >= 2000
		                    and [TimeDim] <= 2018
		            ),
		            Fields = Table.SelectColumns(Selected, {"SpatialDim", "TimeDim", "NumericValue"}),
		            Named = Table.RenameColumns(
		                Fields, {{"SpatialDim", "ISO3"}, {"TimeDim", "Year"}, {"NumericValue", "Rate"}}
		            ),
		            Typed = Table.TransformColumnTypes(
		                Named, {{"ISO3", type text}, {"Year", Int64.Type}, {"Rate", type number}}, "en-US"
		            ),
		            Unique = fxAssertUnique(Typed, {"ISO3", "Year"}, indicator),
		            Joined = Table.NestedJoin(Unique, {"ISO3"}, Geo, {"ISO3"}, "CountryMap", JoinKind.Inner),
		            Expanded = Table.ExpandTableColumn(Joined, "CountryMap", {"Country"}),
		            Fraction = Table.TransformColumns(Expanded, {{"Rate", each fxPercent(_), type number}}),
		            Metric = Table.AddColumn(Fraction, "Metric", each metric, type text),
		            Output = Table.SelectColumns(Metric, {"Country", "Year", "Metric", "Rate"})
		        in
		            Output,
		    Sanitation = GetIndicator(
		        "WSH_SANITATION_BASIC", "WHO_WSH_SANITATION_BASIC_2000_2018.json", "SanitationBasicTotal"
		    ),
		    Hygiene = GetIndicator("WSH_HYGIENE_BASIC", "WHO_WSH_HYGIENE_BASIC_2000_2018.json", "HygieneBasicTotal"),
		    Combined = fxAssertUnique(
		        Table.Combine({Sanitation, Hygiene}), {"Country", "Year", "Metric"}, "OMS indicateur pays année"
		    ),
		    Pivoted = Table.Pivot(Combined, {"SanitationBasicTotal", "HygieneBasicTotal"}, "Metric", "Rate"),
		    Output = Table.TransformColumnTypes(
		        Pivoted,
		        {
		            {"Country", type text},
		            {"Year", Int64.Type},
		            {"SanitationBasicTotal", type number},
		            {"HygieneBasicTotal", type number}
		        },
		        "en-US"
		    )
		in
		    Output
	lineageTag: a18a5325-f6f6-4e65-821c-197c758919c6

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression src_FAOLand =
		let
		    Folder = Text.TrimEnd(pExternalFolder, {"\", "/"}),
		    Archive = Binary.Buffer(
		        if pExternalSourceMode = "En ligne" then
		            Web.Contents(
		                "https://bulks-faostat.fao.org",
		                [
		                    RelativePath = "production/Inputs_LandUse_E_All_Data_(Normalized).zip",
		                    Timeout = #duration(0, 0, 3, 0)
		                ]
		            )
		        else
		            File.Contents(
		                fxLatestExternalFile(
		                    {"FAOSTAT_Inputs_LandUse_Source", "Inputs_LandUse_E_All_Data_(Normalized)"}, {".zip"}
		                )
		            )
		    ),
		    Codes = fxReadZipCsv(Archive, "Inputs_LandUse_E_AreaCodes.csv"),
		    TypedCodes = Table.TransformColumnTypes(Codes, {{"Area Code", type text}, {"Area", type text}}, "en-US"),
		    CountryNames = Table.AddColumn(
		        Table.SelectColumns(Dim_Country, {"Country"}),
		        "FAOName",
		        each
		            if [Country] = "China" then
		                "China; mainland"
		            else if [Country] = "Nauru" then
		                "Naoero"
		            else if [Country] = "Netherlands" then
		                "Netherlands (Kingdom of the)"
		            else if [Country] = "Republic of North Macedonia" then
		                "North Macedonia"
		            else if [Country] = "Turkey" then
		                "Türkiye"
		            else
		                [Country],
		        type text
		    ),
		    MapJoin = Table.NestedJoin(CountryNames, {"FAOName"}, TypedCodes, {"Area"}, "FAOCode", JoinKind.LeftOuter),
		    MapExpanded = Table.ExpandTableColumn(MapJoin, "FAOCode", {"Area Code"}),
		    MissingNames = Table.SelectRows(MapExpanded, each [Area Code] = null),
		    Map =
		        if Table.RowCount(MissingNames) > 0 then
		            error
		                Error.Record(
		                    "MissingFAOCountryMapping", "Libellés FAO à rapprocher explicitement", MissingNames[Country]
		                )
		        else
		            fxAssertUnique(MapExpanded, {"Area Code"}, "Correspondance pays FAO"),
		    Raw = fxReadZipCsv(Archive, "Inputs_LandUse_E_All_Data_(Normalized).csv"),
		    Land = Table.SelectRows(
		        Raw, each [Item Code] = "6601" and [Element Code] = "5110" and [Year] >= "2000" and [Year] <= "2018"
		    ),
		    UnitChecked =
		        if Table.RowCount(Table.SelectRows(Land, each [Unit] <> "1000 ha")) > 0 then
		            error Error.Record("UnexpectedFAOUnit", "Unité attendue : 1000 ha", null)
		        else
		            Land,
		    Fields = Table.SelectColumns(UnitChecked, {"Area Code", "Year", "Value"}),
		    Typed = Table.TransformColumnTypes(
		        Fields, {{"Area Code", type text}, {"Year", Int64.Type}, {"Value", type number}}, "en-US"
		    ),
		    Joined = Table.NestedJoin(Typed, {"Area Code"}, Map, {"Area Code"}, "CountryMap", JoinKind.Inner),
		    Expanded = Table.ExpandTableColumn(Joined, "CountryMap", {"Country"}),
		    Converted = Table.AddColumn(
		        Expanded,
		        "LandAreaKm2",
		        each
		            if [Value] = null then
		                null
		            else if [Value] <= 0 then
		                error Error.Record("InvalidLandArea", "Superficie non positive", [Country])
		            else
		                [Value] * 10,
		        type number
		    ),
		    Output = fxAssertUnique(
		        Table.SelectColumns(Converted, {"Country", "Year", "LandAreaKm2"}), {"Country", "Year"}, "FAO pays année"
		    )
		in
		    Output
	lineageTag: 38ccd6ee-7153-419a-8e5e-eda4beffdf16

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression stg_ExternalContextFromSources =
		let
		    Countries = Table.SelectColumns(Dim_Country, {"Country"}),
		    WithYears = Table.AddColumn(Countries, "Years", each Dim_Year),
		    Grid = Table.ExpandTableColumn(WithYears, "Years", {"Year"}),
		    WHOJoin = Table.NestedJoin(
		        Grid, {"Country", "Year"}, src_OMSContext, {"Country", "Year"}, "WHO", JoinKind.LeftOuter
		    ),
		    WHO = Table.ExpandTableColumn(WHOJoin, "WHO", {"SanitationBasicTotal", "HygieneBasicTotal"}),
		    FAOJoin = Table.NestedJoin(WHO, {"Country", "Year"}, src_FAOLand, {"Country", "Year"}, "FAO", JoinKind.LeftOuter),
		    FAO = Table.ExpandTableColumn(FAOJoin, "FAO", {"LandAreaKm2"}),
		    Typed = Table.TransformColumnTypes(
		        FAO,
		        {
		            {"Country", type text},
		            {"Year", Int64.Type},
		            {"SanitationBasicTotal", type number},
		            {"HygieneBasicTotal", type number},
		            {"LandAreaKm2", type number}
		        },
		        "en-US"
		    ),
		    Unique = fxAssertUnique(Typed, {"Country", "Year"}, "Compléments OMS FAO"),
		    Output =
		        if Table.RowCount(Unique) <> Table.RowCount(Countries) * Table.RowCount(Dim_Year) then
		            error
		                Error.Record(
		                    "ExternalGridSize", "La jointure a modifié la taille de la grille", Table.RowCount(Unique)
		                )
		        else
		            Unique
		in
		    Output
	lineageTag: 6d575539-ade2-443a-971f-bdd701dff95a

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression fxLatestExternalFile =
		(nameTokens as list, extensions as list) as text =>
		    let
		        Folder = Text.TrimEnd(pExternalFolder, {"\", "/"}),
		        Files = Folder.Contents(Folder),
		        Candidates = Table.SelectRows(
		            Files,
		            (row as record) =>
		                List.Contains(extensions, Text.Lower(row[Extension]))
		                and List.AnyTrue(
		                    List.Transform(
		                        nameTokens, (token as text) => Text.Contains(row[Name], token, Comparer.OrdinalIgnoreCase)
		                    )
		                )
		        ),
		        Sorted = Table.Sort(Candidates, {{"Date modified", Order.Descending}, {"Name", Order.Ascending}}),
		        Output =
		            if Table.RowCount(Sorted) = 0 then
		                error
		                    Error.Record(
		                        "MissingExternalSource",
		                        "Aucun fichier brut correspondant dans le dossier",
		                        [
		                            Folder = Folder,
		                            NameTokens = nameTokens,
		                            Extensions = extensions
		                        ]
		                    )
		            else
		                Folder & "/" & Sorted{0}[Name]
		    in
		        Output
	lineageTag: f50aa415-5e2f-4c79-9d1d-df6ae1fdd08b

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

