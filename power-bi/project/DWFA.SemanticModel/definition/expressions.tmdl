	annotation PBI_ResultType = Function

expression fxAssertUnique =
		(input as table, keys as list, label as text) as table =>
		    let
		        Counts = Table.Group(input, keys, {{"RowCount", each Table.RowCount(_), Int64.Type}}),
		        Duplicates = Table.SelectRows(Counts, each [RowCount] > 1),
		        Checked =
		            if Table.RowCount(Duplicates) > 0 then
		                error Error.Record("DuplicateKey", "Clé non unique : " & label, Duplicates)
		            else
		                input
		    in
		        Checked
	lineageTag: 1419a734-9799-48a2-857d-65208b74387e

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression fxPercent =
		(value as nullable number) as nullable number =>
		    if value = null then
		        null
		    else if value < 0 or value > 100.001 then
		        error Error.Record("InvalidPercent", "Pourcentage hors bornes", value)
		    else
		        List.Min({value, 100}) / 100
	lineageTag: 6e59c01b-b868-43d6-a2ad-6e05a6927b51

