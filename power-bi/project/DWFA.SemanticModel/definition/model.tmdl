model Model
	culture: fr-FR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: fr-FR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["pDataFolder","fxReadCsv","fxNormalizeCountry","fxAssertUnique","fxPercent","stg_RegionCountry","stg_CountryGeography","stg_Population","stg_Water","stg_Mortality","stg_Stability","Dim_Country","Dim_Year","Fact_CountryYear","QA_MissingData","Param_Stability","Param_StabilityMode","stg_ExternalContext","pExternalSourceMode","pExternalFolder","fxReadZipCsv","src_OMSContext","src_FAOLand","stg_ExternalContextFromSources","fxLatestExternalFile"]

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop"]

ref table Dim_Country
ref table Dim_Year
ref table Fact_CountryYear
ref table Param_Stability
ref table Param_StabilityMode
ref table _Measures

ref cultureInfo fr-FR

