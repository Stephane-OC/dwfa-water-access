			VAR Available = FILTER ( Eligible, NOT ISBLANK ( Fact_CountryYear[SafeTotal] ) && Fact_CountryYear[PopulationTotal] > 0 )
			RETURN IF ( [Population Total] > 0, COALESCE ( DIVIDE ( SUMX ( Available, Fact_CountryYear[PopulationTotal] ), [Population Total] ), 0 ) )
		formatString: 0.0%
