	measure 'Population Consistency Status' =
			VAR Total = [Population Total]
			VAR Urban = [Population Urban]
			VAR Rural = [Population Rural]
			RETURN IF ( [Eligible Country] = 1,
			    SWITCH ( TRUE (),
			        ISBLANK ( Total ) || Total <= 0, "Total absent",
			        ISBLANK ( Urban ) || ISBLANK ( Rural ), "Ventilation incomplète",
			        ABS ( DIVIDE ( Urban + Rural - Total, Total ) ) > 0.01, "Écart > 1 %",
			        "Écart ≤ 1 %" ) )
		displayFolder: Qualité\Population
		lineageTag: 5eac4211-86f3-45df-807f-7f97298042fb

	measure 'Quality Summary Label' =
			VAR Included = [Countries Included]
			VAR Covered = COALESCE ( [Safe Countries Covered], 0 )
			RETURN IF ( ISBLANK ( [Analysis Year] ), "Choisir une seule année",
			    IF ( Included = 0, "Aucun pays dans le périmètre sélectionné",
			        FORMAT ( Included - Covered, "0" ) & " pays sans indicateur de service sûr exploitable · Une donnée absente ne vaut jamais 0 % d’accès" ) )
		displayFolder: Présentation
		lineageTag: 59d758e8-a81e-48d8-acee-c550c34a4cc3

