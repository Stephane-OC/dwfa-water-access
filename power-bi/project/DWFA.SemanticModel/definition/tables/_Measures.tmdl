table _Measures
	lineageTag: cd7187ee-1424-4f97-977d-043df9a1667c

	measure 'Analysis Year' =
			VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
			RETURN IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
		formatString: 0
		displayFolder: Pilotage
		lineageTag: 54dc5917-f098-4af6-b2a1-abdf252cded0

	measure 'Stability Minimum' = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
		formatString: 0.0
		displayFolder: Pilotage
		lineageTag: 9c21c16f-7a94-45a8-bdaf-5e7131ce081d

	measure 'Stability Filter Enabled' = CONVERT ( IF ( SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil", 1, 0 ), INTEGER )
		formatString: 0
		displayFolder: Pilotage
		lineageTag: ec8e5d95-89a9-48cc-b8ac-72b6ef106e15

	measure 'Population Total' =
			VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
			VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
			VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
			VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
			VAR Eligible = FILTER ( Fact_CountryYear,
			    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
			    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
			RETURN SUMX ( Eligible, Fact_CountryYear[PopulationTotal] )
		formatString: #,0
		displayFolder: Population
		lineageTag: 4caf5e92-09a3-4fb4-b261-0371e51bb846

	measure 'Population Urban' =
			VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
			VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
			VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
			VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
			VAR Eligible = FILTER ( Fact_CountryYear,
			    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
			    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
			RETURN SUMX ( Eligible, Fact_CountryYear[PopulationUrban] )
		formatString: #,0
		displayFolder: Population
		lineageTag: abc37beb-1cd2-4c72-bc7b-52d1fa3f8559

	measure 'Population Rural' =
			VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
			VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
			VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
			VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
			VAR Eligible = FILTER ( Fact_CountryYear,
			    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
			    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
			RETURN SUMX ( Eligible, Fact_CountryYear[PopulationRural] )
		formatString: #,0
		displayFolder: Population
		lineageTag: 7a196141-1fac-4261-a4fa-dd590b5bf1f5

	measure 'Urban Population Share' =
			VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
			VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
			VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
			VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
			VAR Eligible = FILTER ( Fact_CountryYear,
			    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
			    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
			VAR Available = FILTER ( Eligible, NOT ISBLANK ( Fact_CountryYear[PopulationUrban] ) && NOT ISBLANK ( Fact_CountryYear[PopulationRural] ) )
			RETURN DIVIDE ( SUMX ( Available, Fact_CountryYear[PopulationUrban] ), SUMX ( Available, Fact_CountryYear[PopulationUrban] + Fact_CountryYear[PopulationRural] ) )
		formatString: 0.0%
		displayFolder: Population
		lineageTag: 428f4ff5-80d4-428f-aa0e-c9edc13ec051

	measure 'Countries Included' =
			VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
			VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
			VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
			VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
			VAR Eligible = FILTER ( Fact_CountryYear,
			    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
			    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
			RETURN COALESCE ( COUNTROWS ( Eligible ), 0 )
		formatString: 0
		displayFolder: Qualité
		lineageTag: 503385b8-0ec2-4a1f-8f56-a9c6523d19f7

	measure 'Eligible Country' = IF ( HASONEVALUE ( Dim_Country[Country] ) && NOT ISBLANK ( [Analysis Year] ) && [Countries Included] > 0, 1, 0 )
		formatString: 0
		displayFolder: Pilotage
		lineageTag: 49e6dde1-2f1b-4f5a-9e83-d9334fc8a05d

	measure 'Basic Access Total' =
			VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
			VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
			VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
			VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
			VAR Eligible = FILTER ( Fact_CountryYear,
			    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
			    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
			VAR Available = FILTER ( Eligible, NOT ISBLANK ( Fact_CountryYear[BasicTotal] ) && Fact_CountryYear[PopulationTotal] > 0 )
			RETURN DIVIDE ( SUMX ( Available, Fact_CountryYear[BasicTotal] * Fact_CountryYear[PopulationTotal] ), SUMX ( Available, Fact_CountryYear[PopulationTotal] ) )
		formatString: 0.0%
		displayFolder: Accès eau\Total
		lineageTag: c97941d7-3fd4-43dc-adb5-ce89d9cb6816

	measure 'Safe Access Total' =
			VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
			VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
			VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
			VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
			VAR Eligible = FILTER ( Fact_CountryYear,
			    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
			    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
			VAR Available = FILTER ( Eligible, NOT ISBLANK ( Fact_CountryYear[SafeTotal] ) && Fact_CountryYear[PopulationTotal] > 0 )
			RETURN DIVIDE ( SUMX ( Available, Fact_CountryYear[SafeTotal] * Fact_CountryYear[PopulationTotal] ), SUMX ( Available, Fact_CountryYear[PopulationTotal] ) )
		formatString: 0.0%
		displayFolder: Accès eau\Total
		lineageTag: 61e7b2c3-3a51-4d39-9212-54d77625e7b0

	measure 'Basic Countries Covered' =
			VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
			VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
			VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
			VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
			VAR Eligible = FILTER ( Fact_CountryYear,
			    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
			    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
			RETURN COALESCE ( COUNTROWS ( FILTER ( Eligible, NOT ISBLANK ( Fact_CountryYear[BasicTotal] ) && Fact_CountryYear[PopulationTotal] > 0 ) ), 0 )
		formatString: 0
		displayFolder: Qualité
		lineageTag: bd3e2cd5-f580-4dd7-ab76-61ea3f557fb5

	measure 'Basic Population Coverage' =
			VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
			VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
			VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
			VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
			VAR Eligible = FILTER ( Fact_CountryYear,
			    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
			    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
			VAR Available = FILTER ( Eligible, NOT ISBLANK ( Fact_CountryYear[BasicTotal] ) && Fact_CountryYear[PopulationTotal] > 0 )
			RETURN IF ( [Population Total] > 0, COALESCE ( DIVIDE ( SUMX ( Available, Fact_CountryYear[PopulationTotal] ), [Population Total] ), 0 ) )
		formatString: 0.0%
		displayFolder: Qualité
		lineageTag: e5d5a1fe-1607-4218-bf3c-d3f12124b36a

	measure 'People Without Basic Service' =
			VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
			VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
			VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
			VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
			VAR Eligible = FILTER ( Fact_CountryYear,
			    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
			    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
			VAR Available = FILTER ( Eligible, NOT ISBLANK ( Fact_CountryYear[BasicTotal] ) && Fact_CountryYear[PopulationTotal] > 0 )
			RETURN SUMX ( Available, ( 1 - Fact_CountryYear[BasicTotal] ) * Fact_CountryYear[PopulationTotal] )
		formatString: #,0
		displayFolder: Accès eau\Impact
		lineageTag: 09977917-4183-4ef2-9374-f262a90f7407

