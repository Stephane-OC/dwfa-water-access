	measure 'Modernization Point Visible' = IF ( HASONEVALUE ( Dim_Country[Country] ) && NOT ISBLANK ( [Basic Access Comparable] ) && NOT ISBLANK ( [Safe Access Comparable] ), 1, 0 )
