	measure 'Basic Access Comparable' =
			VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
			VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
			VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
			VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
			VAR Eligible = FILTER ( Fact_CountryYear,
			    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
			    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
			VAR Paired = FILTER ( Eligible, Fact_CountryYear[PopulationTotal] > 0 && NOT ISBLANK ( Fact_CountryYear[BasicTotal] ) && NOT ISBLANK ( Fact_CountryYear[SafeTotal] ) )
			RETURN DIVIDE ( SUMX ( Paired, Fact_CountryYear[BasicTotal] * Fact_CountryYear[PopulationTotal] ), SUMX ( Paired, Fact_CountryYear[PopulationTotal] ) )
		formatString: 0.0%
		displayFolder: Modernisation
		lineageTag: 795a1ad3-0d52-4041-a013-e760fe88fe38

	measure 'Safe Access Comparable' =
			VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
			VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
			VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
			VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
			VAR Eligible = FILTER ( Fact_CountryYear,
			    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
			    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
			VAR Paired = FILTER ( Eligible, Fact_CountryYear[PopulationTotal] > 0 && NOT ISBLANK ( Fact_CountryYear[BasicTotal] ) && NOT ISBLANK ( Fact_CountryYear[SafeTotal] ) )
			RETURN DIVIDE ( SUMX ( Paired, Fact_CountryYear[SafeTotal] * Fact_CountryYear[PopulationTotal] ), SUMX ( Paired, Fact_CountryYear[PopulationTotal] ) )
		formatString: 0.0%
		displayFolder: Modernisation
		lineageTag: a765d81b-96a5-4f7e-840d-56e42b96a930

	measure 'Political Stability Mean' =
			VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
			VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
			VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
			VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
			VAR Eligible = FILTER ( Fact_CountryYear,
			    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
			    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
			RETURN AVERAGEX ( Eligible, Fact_CountryYear[PoliticalStability] )
		formatString: 0.00
		displayFolder: Stabilité
		lineageTag: 5190348f-03eb-444a-887d-0a56c8e4e806

	measure 'Mortality Rate Weighted' =
			VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
			VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
			VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
			VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
			VAR Eligible = FILTER ( Fact_CountryYear,
			    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
			    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
			VAR Available = FILTER ( Eligible, NOT ISBLANK ( Fact_CountryYear[MortalityRate] ) && Fact_CountryYear[PopulationTotal] > 0 )
			RETURN DIVIDE ( SUMX ( Available, Fact_CountryYear[MortalityRate] * Fact_CountryYear[PopulationTotal] ), SUMX ( Available, Fact_CountryYear[PopulationTotal] ) )
		formatString: 0.00
		displayFolder: Santé
		lineageTag: 0704e1ef-3c3f-4bc2-95fc-28a094b01bad

	measure 'WASH Deaths' =
			VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
			VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
			VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
			VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
			VAR Eligible = FILTER ( Fact_CountryYear,
			    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
			    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
			RETURN SUMX ( Eligible, Fact_CountryYear[WASHDeaths] )
		formatString: #,0
		displayFolder: Santé
		lineageTag: 5b86c04d-083a-4751-98b5-69ecfaf9b7c9

	measure 'Access Health Profile Score' =
			VAR Access = [Basic Access Total]
			VAR Mortality = [Mortality Rate Weighted]
			RETURN IF ( HASONEVALUE ( Dim_Country[Country] ) && NOT ISBLANK ( Access ) && NOT ISBLANK ( Mortality ),
			    50 * Access + 50 * ( 1 - MIN ( DIVIDE ( Mortality, 100 ), 1 ) ) )
		formatString: 0.0
		displayFolder: Consulting
		lineageTag: d7ce5504-a481-4f4c-b5c4-d51e03435f56

	measure 'Creation Need People' = [People Without Basic Service]
		formatString: #,0
		displayFolder: Création
		lineageTag: a0cc4654-d173-42f4-8ab2-7fc3b00ea63e

	measure 'Year Label' = IF ( HASONEVALUE ( Dim_Year[Year] ), "Année " & FORMAT ( [Analysis Year], "0" ), "Sélectionner une seule année" )
		displayFolder: Présentation
		lineageTag: 8370370e-753a-4e7f-9760-6ba124013fe4

	measure 'Mortality Availability Label' = IF ( [Analysis Year] = 2016, "Mortalité WASH 2016", "Mortalité WASH : donnée disponible uniquement en 2016" )
		displayFolder: Présentation
		lineageTag: 47fcb6ca-5177-4d0f-a1e0-413af855519a

	measure 'Basic Coverage Label' =
			VAR Y = [Analysis Year]
			VAR Included = COALESCE ( [Countries Included], 0 )
			VAR Covered = COALESCE ( [Basic Countries Covered], 0 )
			RETURN SWITCH ( TRUE (),
			    ISBLANK ( Y ), "Choisir une seule année",
			    Included = 0, "Aucun pays dans le périmètre sélectionné",
			    Covered = 0, "Accès basique : donnée indisponible pour ce périmètre et cette année",
			    "Couverture accès basique : " & FORMAT ( Covered, "0" ) & " pays, " & FORMAT ( [Basic Population Coverage], "0.0%" ) & " de la population du périmètre" )
		displayFolder: Présentation
		lineageTag: 0f105f58-8100-4236-9318-f3ac8ab972e7

	measure 'Safe Coverage Label' =
			VAR Y = [Analysis Year]
			VAR Included = COALESCE ( [Countries Included], 0 )
			VAR Covered = COALESCE ( [Safe Countries Covered], 0 )
			RETURN SWITCH ( TRUE (),
			    ISBLANK ( Y ), "Choisir une seule année",
			    Included = 0, "Aucun pays dans le périmètre sélectionné",
			    Covered = 0, "Accès sûr : donnée indisponible pour ce périmètre et cette année",
			    "Couverture accès sûr : " & FORMAT ( Covered, "0" ) & " pays, " & FORMAT ( [Safe Population Coverage], "0.0%" ) & " de la population du périmètre" )
		displayFolder: Présentation
		lineageTag: f5b0f5f9-b1f6-47df-a2cb-f4a6fb41b48c

	measure 'Stability Filter Label' = IF ( [Stability Filter Enabled] = 1, "Stabilité ≥ " & FORMAT ( [Stability Minimum], "0.0" ) & " ; valeurs inconnues exclues", "Stabilité : tous les pays inclus" )
		displayFolder: Présentation
		lineageTag: 60d7e5a3-6986-4e73-9e7c-bd0e782cf510

	measure 'Basic Access Previous Year' =
			VAR Y = [Analysis Year]
			RETURN IF ( NOT ISBLANK ( Y ), CALCULATE ( [Basic Access Total], REMOVEFILTERS ( Dim_Year ), Dim_Year[Year] = Y - 1 ) )
		formatString: 0.0%
		displayFolder: Évolution
		lineageTag: a69cfa5b-bede-464d-945e-e2f1f1af5f54

	measure 'Basic Access Change pp' = IF ( NOT ISBLANK ( [Basic Access Total] ) && NOT ISBLANK ( [Basic Access Previous Year] ), ( [Basic Access Total] - [Basic Access Previous Year] ) * 100 )
		formatString: 0.0
		displayFolder: Évolution
		lineageTag: c9c8c674-392b-4a4c-9757-58ed18e690c6

	measure 'UI Population Color' =
			VAR __MetricValue = [Population Total]
			RETURN IF ( ISBLANK ( __MetricValue ), "#94A3B8", "#2ED3E6" )
		displayFolder: Présentation visuelle\Couleurs
		lineageTag: c7c82c98-3a02-515b-b792-5f40380ad158

	measure 'UI Urban Share Color' =
			VAR __MetricValue = [Urban Population Share]
			RETURN IF ( ISBLANK ( __MetricValue ), "#94A3B8", "#A78BFA" )
		displayFolder: Présentation visuelle\Couleurs
		lineageTag: adff00c6-f2bf-5f37-bdcb-dad3b39a4ad0

	measure 'UI Basic Access Color' =
			VAR __MetricValue = [Basic Access Total]
			RETURN IF ( ISBLANK ( __MetricValue ), "#94A3B8", "#34D399" )
		displayFolder: Présentation visuelle\Couleurs
		lineageTag: e7fc0ffe-d140-5369-a093-25703468d8a8

	measure 'UI Safe Access Color' =
			VAR __MetricValue = [Safe Access Total]
			RETURN IF ( ISBLANK ( __MetricValue ), "#94A3B8", "#34D399" )
		displayFolder: Présentation visuelle\Couleurs
		lineageTag: cc0ebcd7-4a55-5f89-afe7-fbade91d3c4b

	measure 'UI Stability Color' =
			VAR __MetricValue = [Political Stability Mean]
			RETURN SWITCH ( TRUE (), ISBLANK ( __MetricValue ), "#94A3B8", __MetricValue > 0, "#34D399", __MetricValue < 0, "#FB7185", "#94A3B8" )
		displayFolder: Présentation visuelle\Couleurs
		lineageTag: aacf39f8-55d9-5573-9ced-058e48f94bb3

	measure 'UI Basic Change Color' =
			VAR __MetricValue = [Basic Access Change pp]
			RETURN SWITCH ( TRUE (), ISBLANK ( __MetricValue ), "#94A3B8", __MetricValue > 0, "#34D399", __MetricValue < 0, "#FB7185", "#94A3B8" )
		displayFolder: Présentation visuelle\Couleurs
		lineageTag: 97d3aa58-f247-5749-ac3d-d806cbb8bac1

	measure 'UI Mortality Color' =
			VAR __MetricValue = [Mortality Rate Weighted]
			RETURN SWITCH ( TRUE (), ISBLANK ( __MetricValue ), "#94A3B8", __MetricValue > 0, "#FB7185", __MetricValue = 0, "#34D399", "#94A3B8" )
		displayFolder: Présentation visuelle\Couleurs
		lineageTag: e3bbfcef-b98b-5ee9-8064-a7d743497f57

	measure 'UI WASH Deaths Color' =
			VAR __MetricValue = [WASH Deaths]
			RETURN SWITCH ( TRUE (), ISBLANK ( __MetricValue ), "#94A3B8", __MetricValue > 0, "#FB7185", __MetricValue = 0, "#34D399", "#94A3B8" )
		displayFolder: Présentation visuelle\Couleurs
		lineageTag: b033f52b-f02a-595d-acdf-66962df38abc

	measure 'UI Basic Coverage Color' =
			VAR __MetricValue = [Basic Population Coverage]
			RETURN SWITCH ( TRUE (), ISBLANK ( __MetricValue ), "#94A3B8", __MetricValue >= 1 - 0.000000001, "#34D399", __MetricValue > 0, "#FBBF24", "#FB7185" )
		displayFolder: Présentation visuelle\Couverture
