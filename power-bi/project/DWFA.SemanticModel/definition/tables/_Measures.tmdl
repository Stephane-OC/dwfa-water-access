			VAR Observed = FILTER ( Eligible, NOT ISBLANK ( Fact_CountryYear[SanitationBasicTotal] ) && Fact_CountryYear[PopulationTotal] > 0 )
			RETURN COALESCE ( COUNTROWS ( Observed ), 0 )
		formatString: 0
		displayFolder: Compléments OMS FAO\Couverture
		lineageTag: 6223df1a-81e1-499f-968e-70b734e2abe6

