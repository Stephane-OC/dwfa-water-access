	measure 'External Context Label' =
			VAR Y = [Analysis Year]
			RETURN IF ( ISBLANK ( Y ), "Choisir une seule année",
			    "Couverture population : assainissement " & FORMAT ( [Sanitation Population Coverage], "0.0%" ) &
			    " · hygiène " & FORMAT ( [Hygiene Population Coverage], "0.0%" ) &
			    " · densité " & FORMAT ( [Density Population Coverage], "0.0%" ) &
			    " | Compléments OMS/FAO : " & FORMAT ( Y, "0" ) & " · cohortes disponibles" )
		displayFolder: Compléments OMS FAO\Présentation
		lineageTag: e928a049-0762-401f-b8bf-b59af3cd7830

