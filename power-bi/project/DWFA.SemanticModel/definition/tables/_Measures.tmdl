	measure 'Consulting Point Visible' = IF ( HASONEVALUE ( Dim_Country[Country] ) && NOT ISBLANK ( [Access Health Profile Score] ) && NOT ISBLANK ( [Political Stability Mean] ), 1, 0 )
		formatString: 0
		displayFolder: Pilotage
		lineageTag: 62a870b9-9775-40f1-8fe8-32398814d416

	measure 'Creation Top 10 People' =
			VAR Need = [Creation Need People]
			VAR Candidates = FILTER ( ALLSELECTED ( Dim_Country[Country] ), NOT ISBLANK ( [Creation Need People] ) && [Creation Need People] > 0 )
			VAR TopCountries = TOPN ( 10, Candidates, [Creation Need People], DESC, Dim_Country[Country], ASC )
			RETURN IF ( HASONEVALUE ( Dim_Country[Country] ) && NOT ISBLANK ( Need ) && Need > 0 &&
			    CONTAINS ( TopCountries, Dim_Country[Country], SELECTEDVALUE ( Dim_Country[Country] ) ), Need )
		formatString: #,0
		displayFolder: Priorités
		lineageTag: 52b13688-ee37-4e75-82d5-54c51b50225f

	measure 'Modernization Top 10 People' =
			VAR Need = [Modernization Need People]
			VAR Candidates = FILTER ( ALLSELECTED ( Dim_Country[Country] ), NOT ISBLANK ( [Modernization Need People] ) && [Modernization Need People] > 0 )
			VAR TopCountries = TOPN ( 10, Candidates, [Modernization Need People], DESC, Dim_Country[Country], ASC )
			RETURN IF ( HASONEVALUE ( Dim_Country[Country] ) && NOT ISBLANK ( Need ) && Need > 0 &&
			    CONTAINS ( TopCountries, Dim_Country[Country], SELECTEDVALUE ( Dim_Country[Country] ) ), Need )
		formatString: #,0
		displayFolder: Priorités
		lineageTag: 2e8cca5d-16b7-478e-b8b1-dfb874ab0f3d

	measure 'Priority Scope Label' =
			VAR Included = [Countries Included]
			RETURN IF ( ISBLANK ( [Analysis Year] ), "Choisir une seule année",
			    IF ( Included = 0, "Aucun pays admissible : ajuster le périmètre ou le seuil de stabilité",
			        FORMAT ( Included, "0" ) & " pays admissibles · " & [Stability Filter Label] & " · Besoins estimés sur les pays renseignés" ) )
