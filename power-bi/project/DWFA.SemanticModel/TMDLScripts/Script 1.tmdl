createOrReplace
	ref table _Measures
		measure 'Analysis Year' = ```
				VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
				RETURN IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
				```
			formatString: 0
			displayFolder: Pilotage
			lineageTag: 54dc5917-f098-4af6-b2a1-abdf252cded0

		measure 'Stability Minimum' = ```
				CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
				```
			formatString: 0.0
			displayFolder: Pilotage
			lineageTag: 9c21c16f-7a94-45a8-bdaf-5e7131ce081d

		measure 'Stability Filter Enabled' = ```
				CONVERT ( IF ( SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil", 1, 0 ), INTEGER )
				```
			formatString: 0
			displayFolder: Pilotage
			lineageTag: ec8e5d95-89a9-48cc-b8ac-72b6ef106e15

		measure 'Population Total' = ```
				VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
				VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
				VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
				VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
				VAR Eligible = FILTER ( Fact_CountryYear,
				    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
				    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
				RETURN SUMX ( Eligible, Fact_CountryYear[PopulationTotal] )
				```
			formatString: #,0
			displayFolder: Population
			lineageTag: 4caf5e92-09a3-4fb4-b261-0371e51bb846

		measure 'Population Urban' = ```
				VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
				VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
				VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
				VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
				VAR Eligible = FILTER ( Fact_CountryYear,
				    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
				    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
				RETURN SUMX ( Eligible, Fact_CountryYear[PopulationUrban] )
				```
			formatString: #,0
			displayFolder: Population
			lineageTag: abc37beb-1cd2-4c72-bc7b-52d1fa3f8559

		measure 'Population Rural' = ```
				VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
				VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
				VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
				VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
				VAR Eligible = FILTER ( Fact_CountryYear,
				    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
				    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
				RETURN SUMX ( Eligible, Fact_CountryYear[PopulationRural] )
				```
			formatString: #,0
			displayFolder: Population
			lineageTag: 7a196141-1fac-4261-a4fa-dd590b5bf1f5

		measure 'Urban Population Share' = ```
				VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
				VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
				VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
				VAR ApplyFilter = SELECTEDVALUE ( Param_StabilityMode[Mode], "Tous les pays" ) = "Appliquer le seuil"
				VAR Eligible = FILTER ( Fact_CountryYear,
				    NOT ISBLANK ( Y ) && Fact_CountryYear[Year] = Y &&
				    ( NOT ( ApplyFilter ) || ( NOT ISBLANK ( Fact_CountryYear[PoliticalStability] ) && Fact_CountryYear[PoliticalStability] >= Cutoff ) ) )
				VAR Available = FILTER ( Eligible, NOT ISBLANK ( Fact_CountryYear[PopulationUrban] ) && NOT ISBLANK ( Fact_CountryYear[PopulationRural] ) )
				RETURN DIVIDE ( SUMX ( Available, Fact_CountryYear[PopulationUrban] ), SUMX ( Available, Fact_CountryYear[PopulationUrban] + Fact_CountryYear[PopulationRural] ) )
				```
			formatString: 0.0%
			displayFolder: Population
			lineageTag: 428f4ff5-80d4-428f-aa0e-c9edc13ec051

		measure 'Countries Included' = ```
				VAR SelectedYear = SELECTEDVALUE ( Dim_Year[Year] )
				VAR Y = IF ( NOT ISBLANK ( SelectedYear ), CONVERT ( SelectedYear, INTEGER ) )
				VAR Cutoff = CONVERT ( SELECTEDVALUE ( Param_Stability[Minimum], -2.5 ), DOUBLE )
