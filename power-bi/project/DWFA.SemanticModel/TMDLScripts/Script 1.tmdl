		measure 'Basic Coverage Label' = ```
				VAR Y = [Analysis Year]
				VAR Included = COALESCE ( [Countries Included], 0 )
				VAR Covered = COALESCE ( [Basic Countries Covered], 0 )
				RETURN SWITCH ( TRUE (),
				    ISBLANK ( Y ), "Choisir une seule année",
				    Included = 0, "Aucun pays dans le périmètre sélectionné",
				    Covered = 0, "Accès basique : donnée indisponible pour ce périmètre et cette année",
				    "Couverture accès basique : " & FORMAT ( Covered, "0" ) & " pays, " & FORMAT ( [Basic Population Coverage], "0.0%" ) & " de la population du périmètre" )
				```
